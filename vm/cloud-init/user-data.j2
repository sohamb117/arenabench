#cloud-config

# Plan §3.B7 / §3.B10 (Oracle round-25 explicit-deferral note):
#   Per-agent harness systemd autostart units are intentionally absent from
#   this template. The orchestrator drives each harness over SSH after
#   cloud-init completes — see orchestrator/lifecycle.py and
#   orchestrator/cli.py::_drive_match. An autostart unit would fire before
#   the orchestrator finished establishing the runtime channel (vsock or
#   ssh), so the first turn's stdout would be discarded.
#
#   If a future revision moves harness lifecycle into the guest VM
#   (vsock-first runtime per the deferred B10 follow-up), restore a
#   `arenabench-harness@<slot>.service` unit here with `Restart=no` +
#   `Type=notify` so the orchestrator can synchronize the hand-off. Until
#   then, SSH-driven spawn is the contract and this file deliberately
#   leaves the runcmd block focused on users, secrets, and network policy.

ssh_pwauth: false
disable_root: false

users:
  - name: root
    lock_passwd: false
    ssh_authorized_keys:
      - "{{ ssh_pubkey }}"
{% for agent in agents %}
  - name: {{ agent.user }}
    shell: /bin/bash
    groups: [users]
    lock_passwd: true
    sudo: false
    ssh_authorized_keys:
      - "{{ ssh_pubkey }}"
{% endfor %}
write_files:
{% for agent in agents %}
  - path: /home/{{ agent.user }}/config.json
    owner: '{{ agent.user }}:{{ agent.user }}'
    permissions: '0600'
    defer: true
    content: |
{{ agent.config_blob | indent(6, first=True) }}
  - path: /home/{{ agent.user }}/system_prompt.txt
    owner: '{{ agent.user }}:{{ agent.user }}'
    permissions: '0600'
    defer: true
    content: |
{{ agent.prompt_blob | indent(6, first=True) }}
  - path: /home/{{ agent.user }}/.secrets
    owner: '{{ agent.user }}:{{ agent.user }}'
    permissions: '0600'
    defer: true
    content: |
{% for k, v in agent.env_vars %}
      export {{ k }}={{ v }}
{% endfor %}
{% endfor %}
{% if proxy_target and network_policy == "allowlist" %}
  - path: /etc/profile.d/arenabench-proxy.sh
    owner: 'root:root'
    permissions: '0644'
    content: |
      export HTTPS_PROXY=http://{{ proxy_target.guest_addr }}:{{ proxy_target.port }}
      export HTTP_PROXY=http://{{ proxy_target.guest_addr }}:{{ proxy_target.port }}
      export NO_PROXY=127.0.0.1,localhost
      export AIOHTTP_TRUST_ENV=True
{% endif %}
runcmd:
{% for agent in agents %}
  - chmod 0700 /home/{{ agent.user }}
{% endfor %}
  - chmod o+x /root
  - chmod -R o+rX /root/.local
{% if network_policy == "full" %}
  - iptables -F
  - iptables -X
  - iptables -P INPUT ACCEPT
  - iptables -P FORWARD ACCEPT
  - iptables -P OUTPUT ACCEPT
{% elif proxy_target %}
  - iptables -A OUTPUT -p tcp -d {{ proxy_target.guest_addr }} --dport {{ proxy_target.port }} -j ACCEPT
{% endif %}
