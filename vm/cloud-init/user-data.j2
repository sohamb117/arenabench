#cloud-config

ssh_pwauth: false
disable_root: false

users:
  - name: root
    lock_passwd: false
    ssh_authorized_keys:
      - "{{ ssh_pubkey }}"
{% for agent in agents %}
  - name: {{ agent.user }}
    shell: /bin/bash
    groups: [users]
    lock_passwd: true
    sudo: false
    ssh_authorized_keys:
      - "{{ ssh_pubkey }}"
{% endfor %}
write_files:
{% for agent in agents %}
  - path: /home/{{ agent.user }}/config.json
    owner: '{{ agent.user }}:{{ agent.user }}'
    permissions: '0600'
    defer: true
    content: |
{{ agent.config_blob | indent(6, first=True) }}
  - path: /home/{{ agent.user }}/system_prompt.txt
    owner: '{{ agent.user }}:{{ agent.user }}'
    permissions: '0600'
    defer: true
    content: |
{{ agent.prompt_blob | indent(6, first=True) }}
  - path: /home/{{ agent.user }}/.secrets
    owner: '{{ agent.user }}:{{ agent.user }}'
    permissions: '0600'
    defer: true
    content: |
{% for k, v in agent.env_vars %}
      export {{ k }}={{ v }}
{% endfor %}
{% endfor %}
runcmd:
{% for agent in agents %}
  - chmod 0700 /home/{{ agent.user }}
{% endfor %}
{% if network_policy == "full" %}
  - iptables -F
  - iptables -X
  - iptables -P INPUT ACCEPT
  - iptables -P FORWARD ACCEPT
  - iptables -P OUTPUT ACCEPT
{% endif %}
